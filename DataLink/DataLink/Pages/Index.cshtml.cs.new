using Microsoft.AspNetCore.Mvc.RazorPages;
using DataLink.Models;
using DataLink.Services;
using Newtonsoft.Json;
using System.Diagnostics;

namespace DataLink.Pages
{
    public class IndexModel : PageModel
    {
        private readonly IEmailService _emailService;
        public List<Article> Articles { get; set; } = new();
        public string? EmailStatus { get; set; }

        public IndexModel(IEmailService emailService)
        {
            _emailService = emailService;
        }

        public async Task OnGetAsync()
        {
            string currentDirectory = Directory.GetCurrentDirectory();
            string pythonScriptPath = Path.Combine(currentDirectory, "..\\..\\WebScraping\\dist\\Main.exe");

            try
            {
                var result = await RunPythonScriptAsync(pythonScriptPath);
                var scrapedData = ParseScrapedData(result);
                
                // Send email with the scraped data
                try
                {
                    await _emailService.SendNewsDigestAsync(scrapedData);
                    EmailStatus = "Email sent successfully!";
                }
                catch (Exception emailEx)
                {
                    EmailStatus = $"Error sending email: {emailEx.Message}";
                }

                // Flatten articles for display
                Articles = scrapedData.Categories.SelectMany(c => c.Value)
                    .Concat(scrapedData.Other)
                    .ToList();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error running script: {ex.Message}");
                EmailStatus = $"Error scraping data: {ex.Message}";
            }
        }

        private async Task<string> RunPythonScriptAsync(string exePath)
        {
            var start = new ProcessStartInfo
            {
                FileName = exePath,
                UseShellExecute = false,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                CreateNoWindow = true
            };

            using var process = new Process { StartInfo = start };
            process.Start();

            var outputTask = process.StandardOutput.ReadToEndAsync();
            var errorTask = process.StandardError.ReadToEndAsync();

            await Task.WhenAll(outputTask, errorTask);
            process.WaitForExit();

            string output = await outputTask;
            string error = await errorTask;

            if (!string.IsNullOrEmpty(error))
            {
                throw new Exception($"Python error: {error}");
            }

            return output;
        }

        private ScrapedData ParseScrapedData(string result)
        {
            try
            {
                var scrapedData = JsonConvert.DeserializeObject<ScrapedData>(result);
                return scrapedData ?? new ScrapedData();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error parsing JSON: {ex.Message}");
                return new ScrapedData();
            }
        }
    }
}
